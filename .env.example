# Exemplo para rodar o serviço na máquina local (apps no host). Copie para .env e preencha; o .env NUNCA vai para o Git.
# Gere segredos com:  openssl rand -base64 48

# Banco próprio do serviço (PostgreSQL)
AUDIT_DB_URL=jdbc:postgresql://localhost:5433/audit
AUDIT_DB_USER=audit
AUDIT_DB_PASSWORD=

# Credenciais de acesso (ao menos 32 caracteres e diferentes entre si). O serviço não sobe sem elas.
# Leitura: consulta de eventos (gerenciador). Administração: cadastro de aplicações e chaves.
AUDIT_READ_TOKEN=
AUDIT_ADMIN_TOKEN=

# Opcionais (valores padrão em application.yml)
# SERVER_PORT=8090
# LOG_LEVEL=INFO
# AUDIT_MAX_BATCH=100
# AUDIT_MAX_DETAIL_BYTES=4096
# AUDIT_REQUESTS_PER_MINUTE_PER_KEY=1200
# AUDIT_RETENTION_DEFAULT_DAYS=365
# AUDIT_RETENTION_INTERVAL=PT6H
